# COPIAR COMO .env EN EL SERVIDOR Y REEMPLAZAR TODOS LOS VALORES
APP_NAME="PlantCore Service Desk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://service-desk.devalejandre.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REEMPLAZAR_BD_HOSTINGER
DB_USERNAME=REEMPLAZAR_USUARIO_HOSTINGER
DB_PASSWORD=REEMPLAZAR_PASSWORD_HOSTINGER
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=true
